{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFG Unlocker GUI",
  "version": "0.1.0",
  "identifier": "com.lashman.mfgunlockergui",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MFG Unlocker GUI",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
